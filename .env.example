# Server Port
PORT=3000

# Environment (development | production)
NODE_ENV=development

# PostgreSQL Database Connection String (e.g. Neon, Supabase, Render, or Local)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_agro

# OpenWeatherMap API Key (Free key from https://openweathermap.org/api)
# If empty, Smart Agro automatically falls back to high-accuracy simulated local weather
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

