{
  "name": "smart-agro",
  "version": "1.0.0",
  "description": "Smart Agro - Production-ready AI Crop Disease Scanner, Cultivation Guide & Weather Agro-Alert Web App for Bangladeshi Farmers",
  "main": "server.js",
  "scripts": {
    "build": "echo 'Smart Agro production assets verified in public/'",
    "start": "node server.js",
    "start:all": "bash start_services.sh",
    "dev": "node --watch server.js",
    "docs": "node scripts/generators/generate-docs.js",
    "sync:nav": "node scripts/generators/sync-navbar.js",
    "test": "node scripts/tests/verify-smart-agro.js",
    "test:smoke": "node scripts/tests/verify-local-smoke.js",
    "test:browser": "node scripts/tests/browser-scanner-test.js",
    "cap:sync": "cap sync android",
    "android:build": "cap sync android && cd android && export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 && ./gradlew assembleDebug",
    "android:open": "cap open android"
  },
  "keywords": [
    "smart-agro",
    "bangladesh",
    "agriculture",
    "crop-disease-detection",
    "glassmorphism",
    "nodejs",
    "express",
    "postgresql",
    "weather-alerts"
  ],
  "author": "Smart Agro Team",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "axios": "^1.7.2",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.6.0",
    "pg": "^8.11.5"
  }
}
