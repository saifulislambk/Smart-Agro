# ====================================================================
# Smart Agro (স্মার্ট এগ্রো) - Production Environment Variables Template
# Copy this file to .env or configure in your deployment dashboard
# (e.g., Vercel, Netlify, Render, or Hugging Face Spaces)
# ====================================================================

# Node Runtime Environment
NODE_ENV=production
PORT=3000

# Python Flask AI Microservice Inter-Service Endpoints
# Hosted on Hugging Face Spaces (2 vCPU, 16GB RAM free tier) or Render/Docker
# Format: https://<hf-user>-smart-agro-ai.hf.space
AI_SERVICE_URL=https://<your-huggingface-space>.hf.space/predict
AI_HEALTH_URL=https://<your-huggingface-space>.hf.space/health

# AI Microservice Proxy Timeout in Milliseconds
# Default is 30000 (30 seconds) to tolerate container wake-up latency on cold starts
AI_TIMEOUT_MS=30000

# Cloud PostgreSQL Database Connection String
# Recommended Free Tier: Neon.tech Serverless Postgres (0.5GB storage, pooled connection)
# or Supabase Free Tier.
# Note: Neon requires SSL. Use the pooled connection URL ending with ?sslmode=require.
# Example: postgresql://neondb_owner:npg_secret@ep-quiet-grass-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# ZERO-COST FALLBACK: If left empty or unreachable, Smart Agro automatically operates
# with its built-in in-memory repository (pre-seeded with 40+ crop guides and sample scans).
DATABASE_URL=

# OpenWeatherMap API Key (Free tier from https://openweathermap.org/api)
# ZERO-COST FALLBACK: If empty, Smart Agro automatically activates its high-precision
# 64-district Bangladesh meteorological simulation model with agro-advisories.
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
WEATHERAPI_KEY=your_weatherapi_key_here
